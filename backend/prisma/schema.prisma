// Nexa VPN — data model (billing foundation)
// PostgreSQL via Prisma ORM.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Role {
  USER
  PREMIUM
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum ServerProtocol {
  WIREGUARD
  OPENVPN
  IKEV2
}

enum ServerStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  UNAVAILABLE
  DISABLED
}

/// Product codes of the subscription plans.
enum PlanCode {
  MONTHLY
  QUARTERLY
  YEARLY
  LIFETIME
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

/// Extensible payment provider registry (real integrations come later).
enum PaymentProvider {
  INTERNAL
  YOOKASSA
  SBP
  CARD
  APPLE
  GOOGLE
  CRYPTO
}

// ── User ─────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  country      String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  lastLogin    DateTime?
  trialUsedAt  DateTime?

  subscriptions      Subscription[]
  connectionLogs     ConnectionLog[]
  notifications      Notification[]
  devices            Device[]
  accessKeys         AccessKey[]
  paymentTransactions PaymentTransaction[]

  @@index([role])
  @@index([status])
}

// ── VPN Server ───────────────────────────────────────────────────────────

model VpnServer {
  id          String   @id @default(uuid())
  name        String
  country     String
  countryCode String
  city        String
  ip          String   @unique
  protocol    ServerProtocol @default(WIREGUARD)
  port        Int?     // VLESS ingress port (null = default 443)
  transport   String?  // VLESS transport: tcp | ws | grpc (null = tcp)
  security    String?  // VLESS security: none | tls | reality (null = none)
  sni         String?  // TLS/REALITY SNI for the ingress
  flow        String?  // VLESS flow (e.g. xtls-rprx-vision) — public param
  publicKey   String?  // REALITY public key (pbk) — public, NOT a secret
  shortId     String?  // REALITY short id (sid) — public param
  load        Float    @default(0)
  ping        Int      @default(0)
  premium     Boolean  @default(false)
  status      ServerStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connectionLogs ConnectionLog[]
  accessKeys     AccessKey[]

  @@index([status])
  @@index([country])
}

// ── Subscription Plan ────────────────────────────────────────────────────
// The sellable product. NOT tied to any payment provider.

model SubscriptionPlan {
  id          String    @id @default(uuid())
  code        PlanCode  @unique
  name        String
  description String?
  durationDays Int
  price       Decimal   @db.Decimal(10, 2)
  currency    String    @default("USD")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subscriptions      Subscription[]
  paymentTransactions PaymentTransaction[]
}

// ── Subscription ─────────────────────────────────────────────────────────

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  paymentTransactions PaymentTransaction[]

  @@index([userId, status])
  @@index([planId])
}

// ── Payment Transaction ──────────────────────────────────────────────────
// One row per checkout attempt. `providerPaymentId` is the provider-side
// id; the unique pair (provider, providerPaymentId) is the idempotency key
// for webhook events (PostgreSQL treats NULLs as distinct, so PENDING rows
// without a provider id do not collide).

model PaymentTransaction {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId    String?
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planId            String?         // plan resolved at checkout (billing truth)
  plan              SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  provider          PaymentProvider
  providerPaymentId String?
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("USD")
  status            PaymentStatus   @default(PENDING)
  idempotencyKey    String?         // client-supplied key (checkout dedup)
  webhookEvent      String?         // last webhook event received (payment.paid, ...)
  webhookProcessedAt DateTime?      // last webhook processing timestamp
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([provider, providerPaymentId])
  @@index([userId])
  @@index([status])
  @@index([idempotencyKey])
}

// ── Banner ───────────────────────────────────────────────────────────────

model Banner {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  buttonText  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

// ── Connection Log ───────────────────────────────────────────────────────

model ConnectionLog {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId       String
  server         VpnServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  durationSec    Int?
  trafficMb      Int?
  createdAt      DateTime  @default(now())

  @@index([userId, connectedAt])
  @@index([serverId, connectedAt])
}

// ── Notification ─────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

// ── Device ────────────────────────────────────────────────────────────────

model Device {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  platform   String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  accessKeys AccessKey[]

  @@index([userId])
}

// ── AccessKey (Provisioning) ──────────────────────────────────────────────

model AccessKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String?
  device     Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  serverId   String?   // deterministic ingress assignment (TASK #011)
  server     VpnServer? @relation(fields: [serverId], references: [id], onDelete: SetNull)
  name       String
  protocol   String    @default("VLESS")
  uuid       String    @unique
  status     String    @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?

  @@index([userId, status])
  @@index([serverId])
}

// ── Webhook Log ───────────────────────────────────────────────────────────
// Audit journal of every webhook event (verified or not).

model WebhookLog {
  id            String   @id @default(uuid())
  provider      String
  event         String
  transactionId String?
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([provider, createdAt])
}
