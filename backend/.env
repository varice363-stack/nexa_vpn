# ── Morok VPN Backend Environment Variables (для тестирования) ────────────

# ─ Database ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://morok:morok@localhost:5432/morok_vpn?schema=public"

# ── Authentication ───────────────────────────────────────────────────────
JWT_SECRET="morok-dev-secret-key-change-in-production-1234567890"
JWT_EXPIRES_IN="7d"

# ── CORS ────────────────────────────────────────────────────────────────
# Разрешаем localhost и локальную сеть для тестирования с телефона
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://192.168.0.9:3000"

# ── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── YooKassa (Payment) ─────────────────────────────────────────────────
# Для тестирования оставь пустым
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
PAYMENT_RETURN_URL="http://localhost:3000/payment/success"

# ── Environment ─────────────────────────────────────────────────────────
NODE_ENV=development

# ── Server ───────────────────────────────────────────────────────────────
# 0.0.0.0 = слушать все интерфейсы (нужно для подключения с телефона)
HOST=0.0.0.0
PORT=3000
UPLOADS_DIR=uploads

# ── Admin ────────────────────────────────────────────────────────────────
# Код администратора MOROK VPN
OWNER_CODE=MOROK-ADMIN-2026
