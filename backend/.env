# ── Nexa VPN Backend Environment Variables ─────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexa_vpn"

# ── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET="nexa-vpn-jwt-secret-change-me-in-production-2026"
JWT_EXPIRES_IN="7d"

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── YooKassa (Payment) ─────────────────────────────────────────────────────
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
PAYMENT_RETURN_URL="http://localhost:3000/payment/success"

# ── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
UPLOADS_DIR=uploads

# ── Admin ───────────────────────────────────────────────────────────────────
OWNER_CODE=NEXA-XMAE-7RPQ-C6CE-TYFW
