# ── Nexa VPN Backend Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — only .env.example

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/nexa_vpn"

# ── Authentication ──────────────────────────────────────────────────────────
# JWT secret — generate a strong random string (min 32 chars)
# Example: openssl rand -base64 48
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Production: https://yourdomain.com,https://admin.yourdomain.com
# Development: http://localhost:3000,http://localhost:3001
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ── Rate Limiting ───────────────────────────────────────────────────────────
# General API: requests per 15 minutes per IP
RATE_LIMIT_MAX=100
# Auth endpoints (login/register): requests per 15 minutes per IP
AUTH_RATE_LIMIT_MAX=10

# ── YooKassa (Payment) ─────────────────────────────────────────────────────
# Get credentials from https://yookassa.ru
YOOKASSA_SHOP_ID="your-shop-id"
YOOKASSA_SECRET_KEY="your-secret-key"
PAYMENT_RETURN_URL="https://yourdomain.com/payment/success"

# ── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development
# NODE_ENV=production  # for production deployment

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
UPLOADS_DIR=uploads
