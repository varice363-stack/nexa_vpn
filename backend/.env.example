# ── Nexa VPN Backend Environment Variables ─────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────
# Замени nexa:nexa на реальные credentials твоей PostgreSQL
DATABASE_URL="postgresql://nexa:nexa@localhost:5432/nexa_vpn?schema=public"

# ── Authentication ───────────────────────────────────────────────────────
# CRITICAL: JWT_SECRET must be a random string of at least 32 characters!
# Generate one: openssl rand -base64 64
# DO NOT use default values in production - this is a critical security vulnerability!
JWT_SECRET="CHANGE_ME_TO_RANDOM_64_CHAR_STRING"
JWT_EXPIRES_IN="7d"

# ── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── YooKassa (Payment) ──────────────────────────────────────────────────
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
PAYMENT_RETURN_URL="http://localhost:3000/payment/success"

# ── Environment ─────────────────────────────────────────────────────────
NODE_ENV=development

# ── Server ───────────────────────────────────────────────────────────────
# 0.0.0.0 = слушать все интерфейсы (нужно для подключения с телефона)
# localhost = только локально (для prod за nginx)
HOST=0.0.0.0
PORT=3000
UPLOADS_DIR=uploads

# ── Admin ───────────────────────────────────────────────────────────────
# Только для внутренней (owner) сборки. В публичную сборку не попадает.
OWNER_CODE=

# ── Xray ingress defaults (TASK #028) ────────────────────────────────────
# Применяются ТОЛЬКО когда значение не задано в записи VpnServer в БД.
# sni: какой сертификат показывает Reality-нода при handshake.
XRAY_DEFAULT_SNI=telegram.org
# flow: обязателен для vision-рукоятки Xray, иначе sing-box отваливается.
XRAY_DEFAULT_FLOW=xtls-rprx-vision
# pbk/sid — ключевой материал: по умолчанию берётся строго из БД (per-node).
# Эти переменные — только флот-дефолт для однонодовой установки; оставь пустым,
# если узлов больше одного, иначе клиенты поедут на чужую ноду молча.
XRAY_REALITY_PUBLIC_KEY=
XRAY_REALITY_SHORT_ID=

# ── Admin panel ───────────────────────────────────────────────────────
# Пароль учётки admin@morokvpn.app (вход в веб-панель). После изменения
# выполнить: docker compose exec backend npm run prisma:seed
ADMIN_PASSWORD=
# Куда прокси Next (./api/*) отправляет запросы. Для контейнера morok_admin,
# запущенного в network_mode: host, это адрес бэкенда на хосте.
ADMIN_API_PROXY_ORIGIN=http://127.0.0.1:3000

# ── Приём USDT (TASK #029) ────────────────────────────────────────────
# Основной способ оплаты: mock | yookassa | crypto.
# crypto = USDT доступен ВСЕГДА (второй способ), этот ключ лишь делает его
# основным на экране «Premium». Ничего не ломается, если кошельки пустые:
# просто UI не покажет крипту как способ оплаты.
PAYMENT_PROVIDER=mock
# Кошельки (TRC20 — дешёвая комиссия, BEP20 — запасной). Без адреса сеть
# считается выключенной и в /billing/crypto/wallets не попадёт.
USDT_TRC20_ADDRESS=
USDT_BEP20_ADDRESS=
# Какой сети отдавать приоритет, если клиент не указал network.
CRYPTO_NETWORK=TRC20
# Курс ₽ за 1 USDT. 0 = не пересчитывать, выставлять цену тарифа как есть.
USDT_RATE_RUB=0
# Скидка в рублях за оплату криптой (применяется на сервере, клиент её не видит).
CRYPTO_DISCOUNT_RUB=60
# Сколько минут живёт инвойс, после — «expire» чистит его в CANCELLED.
CRYPTO_INVOICE_TTL_MIN=60
