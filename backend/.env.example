# Копия этого файла -> backend/.env (в .gitignore). Права: chmod 600 backend/.env
#
# ВНИМАНИЕ: backend/.env был в гите до 07.10.2026 вместе с боевыми
# JWT_SECRET / OWNER_CODE / паролем БД. Все три значение ротированы —
# старые не использовать.

# ── PostgreSQL ───────────────────────────────────────────────────────────
DB_USER=morok
DB_NAME=morok_vpn
DB_PASSWORD=<openssl rand -base64 24>

# ── Backend ──────────────────────────────────────────────────────────────
JWT_SECRET=<openssl rand -base64 48>
# Код для X-Owner-Code: доступ к админ-эндпоинтам без JWT.
OWNER_CODE=MOROK-XXXX-XXXX-XXXX-XXXX
# Пароль учётки admin@morokvpn.app — применяется только через npm run prisma:seed
ADMIN_PASSWORD=<openssl rand -base64 24>
# Список origin'ов панели через запятую; * оставляет только если панели нет в инете
CORS_ORIGINS=*
