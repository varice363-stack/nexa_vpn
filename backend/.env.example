# PostgreSQL connection string
DATABASE_URL="postgresql://nexa:nexa@localhost:5432/nexa_vpn?schema=public"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# API
PORT=3000

# Uploads (banner images, dev local storage)
UPLOADS_DIR="./uploads"

# ── Billing (TASK #009-C) ─────────────────────────────────────────────────
# Payment provider: mock | real (real throws until a provider is implemented)
PAYMENT_PROVIDER="mock"
PAYMENT_SECRET=""
PAYMENT_WEBHOOK_SECRET="mock-signature"
PAYMENT_RETURN_URL="https://nexavpn.app/payment/result"
# Auto-cleanup of stale PENDING transactions (ms; 0 = disabled)
BILLING_CLEANUP_INTERVAL_MS="0"
# Webhook replay-protection window (ms)
WEBHOOK_TOLERANCE_MS="300000"

# ── Xray node (TASK #013) ──────────────────────────────────────────────────
# Real ingress parameters come from the VPS setup (scripts/xray-node-setup.sh).
# The backend stores ONLY public params on the VpnServer row; privateKey
# never leaves the node. Env vars below are for future control-plane tooling.
XRAY_CONTROL_BASE_URL=""
XRAY_CONTROL_API_KEY=""
XRAY_NODE_SSH_HOST=""
XRAY_NODE_SSH_USER=""

# ── YooKassa (TASK #015) ───────────────────────────────────────────────────
# Real payment provider (PAYMENT_PROVIDER="real"). Credentials come from
# the YooKassa merchant dashboard. NEVER commit real values.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
