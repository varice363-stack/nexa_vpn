<?xml version="1.0" encoding="utf-8"?>
<!--
  MOROK VPN adaptive-icon foreground.
  Sharp geometric "M" — white→teal gradient feel, centred in 108×108 viewport.
  Safe zone: 18-90 (72 dp square).
-->
