        android:fillColor="#FFFFFF"
        android:pathData="
            M 24,72
            L 24,26
            L 36,26
            L 54,52
            L 72,26
            L 84,26
            L 84,72
            L 73,72
            L 73,42
            L 59,62
            L 55,62
            L 55,62
            L 49,62
            L 35,42
            L 35,72
            Z"
        android:strokeWidth="0" />

    <!-- Teal accent bar at the bottom — subtle brand tint -->
    <path
        android:fillColor="#22D3EE"
        android:pathData="
            M 28,78
            L 80,78
            L 78,82
            L 30,82
            Z"
        android:fillAlpha="0.7"
        android:strokeWidth="0" />
</vector>
