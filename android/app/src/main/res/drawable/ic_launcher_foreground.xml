    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Main M glyph: bold, sharp, slightly wider than tall.
         Outer bounds x 24-84, y 26-72. Fits safely inside 18-90 zone. -->
