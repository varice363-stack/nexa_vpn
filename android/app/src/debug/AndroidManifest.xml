<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug builds may call the local backend over plain HTTP (LAN dev).
         Release builds keep the platform default (cleartext blocked). -->
    <application android:usesCleartextTraffic="true" tools:targetApi="28" xmlns:tools="http://schemas.android.com/tools"/>
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
